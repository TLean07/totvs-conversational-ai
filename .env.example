# ==========================================
# Variáveis de Ambiente do Docker Compose
# ==========================================

# Insira aqui o IP público (ou domínio) da sua máquina na nuvem (VPS).
# IMPORTANTE: Se for rodar na sua própria máquina local para testar antes de subir na nuvem, use: 
# SERVER_IP=localhost
SERVER_IP=localhost

# Oracle Database (FIAP). Usuario RMxxxxxx e senha do aluno.
# Nunca commite usuario/senha reais neste arquivo.
ORACLE_URL=jdbc:oracle:thin:@//oracle.fiap.com.br:1521/orcl
ORACLE_USER=RM000000
ORACLE_PASSWORD=troque-pela-senha-do-oracle
# Opcional: tamanho do pool (o usuario FIAP permite 20 sessoes)
ORACLE_POOL_SIZE=5
# Opcional: cache de leitura em memoria do backend (segundos / entradas)
CACHE_TTL_SECONDS=120
CACHE_MAX_ENTRIES=1000

# Segurança da API
APP_JWT_SECRET=troque-por-uma-string-aleatoria-com-32-caracteres-ou-mais
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=troque-por-uma-senha-forte-com-12-caracteres-ou-mais
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Lax

# Token compartilhado apenas entre backend e ai-service
AI_SERVICE_TOKEN=troque-por-outro-token-aleatorio-com-32-caracteres-ou-mais
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_MAX_RETRIES=1

# AI Service 100% gratuito
AI_SERVICE_REQUIRE_TOKEN=false
AI_CORS_ALLOWED_ORIGINS=http://localhost:8080
AI_PROVIDER=auto
AI_MODEL_NAME=nlptown/bert-base-multilingual-uncased-sentiment
AI_MAX_CHARS=20000
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=3600
AI_CACHE_MAX_ENTRIES=256

# Transcricao automatica opcional por Parakeet
TRANSCRIPTION_PROVIDER=manual
PARAKEET_ENABLED=false
PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v3
PARAKEET_DEVICE=auto
PARAKEET_MAX_AUDIO_MB=100
PARAKEET_MAX_DURATION_SECONDS=3600
PARAKEET_LANGUAGE=pt
PARAKEET_USE_TIMESTAMPS=false
PARAKEET_CACHE_DIR=
